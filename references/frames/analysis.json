        {
          "start": 124.73,
          "end": 125.73,
          "text": "一人食的"
        },
        {
          "start": 125.73,
          "end": 127.73,
          "text": "再加简单舒适一下"
        },
        {
          "start": 127.73,
          "end": 128.73,
          "text": "就准备去上班了"
        },
        {
          "start": 128.73,
          "end": 130.73,
          "text": "喷上我在清卖买的香水"
        },
        {
          "start": 130.73,
