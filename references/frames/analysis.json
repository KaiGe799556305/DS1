      "segments": [
        {
          "start": 0.0,
          "end": 3.0,
          "text": "Hello 大家欢迎收看我的国旗打工日记"
        },
        {
          "start": 3.0,
          "end": 5.12,
          "text": "假期过后一切会复正常"
        },
        {
          "start": 5.12,
          "end": 8.0,
          "text": "偶尔运动一下健康饮食也蛮不错的"
        },
        {
          "start": 8.0,
          "end": 11.0,
          "text": "早上好各位回归咱们的打工系列"
        },
        {
          "start": 11.0,
          "end": 14.0,
          "text": "如果问亲外旅游的视频为啥还没剪出来"
        },
        {
          "start": 14.0,
          "end": 16.0,
          "text": "那就是我最近偷懒了"
        },
        {
          "start": 16.0,
          "end": 17.0,
          "text": "不过会眨眨紧的"
        },
        {
          "start": 17.0,
          "end": 19.0,
          "text": "毕竟这次旅行还蛮精彩的"
        },
        {
          "start": 19.0,
          "end": 21.0,
          "text": "今天穿了一件紫色的花包场去"
        },
        {
          "start": 21.0,
          "end": 24.0,
          "text": "版型非常简约 质感也很完美"
        },
        {
          "start": 24.0,
          "end": 25.0,
          "text": "来厨房做个早餐"
        },
        {
          "start": 25.0,
          "end": 27.0,
          "text": "最近研究出的一个果树之配方"
        },
        {
          "start": 27.0,
          "end": 29.0,
          "text": "非常健康的样子呢"
        },
        {
          "start": 30.0,
          "end": 31.0,
          "text": "再来做一个三明治"
        },
        {
          "start": 31.0,
          "end": 33.0,
          "text": "不小心火开大了 稍微有点糊"
        },
        {
          "start": 33.0,
          "end": 34.0,
          "text": "散了错货能吃"
        },
        {
          "start": 34.0,
          "end": 36.0,
          "text": "打包好早餐就来上班了"
        },
        {
          "start": 36.0,
          "end": 39.0,
          "text": "这个角落的宫位真的是且看气珍惜"
        },
        {
          "start": 39.0,
          "end": 41.0,
          "text": "过段时间就要搬座位了"
        },
        {
          "start": 41.0,
          "end": 43.0,
          "text": "加上工作上有一点小便宜"
        },
        {
          "start": 43.0,
          "end": 45.0,
          "text": "整个人的沈经崩得也很紧"
        },
        {
          "start": 45.0,
          "end": 48.0,
          "text": "无休时间想约着朋友来打个羽毛球"
        },
        {
          "start": 48.0,
          "end": 49.0,
          "text": "解压一下"
        },
        {
          "start": 49.0,
          "end": 51.0,
          "text": "回去换了套偏运动型的衣服"
        },
        {
          "start": 51.0,
          "end": 54.0,
          "text": "我就是那种典型的恰盛文剧多"
        },
        {
          "start": 54.0,
          "end": 55.0,
          "text": "装备还是挺齐全的"
        },
        {
          "start": 55.0,
          "end": 57.0,
          "text": "这次去的是一个全新的场所"
        },
        {
          "start": 57.0,
          "end": 58.0,
          "text": "周边环境特别好"
        },
        {
          "start": 58.0,
          "end": 59.0,
          "text": "加上天气不错嘛"
        },
        {
          "start": 59.0,
          "end": 61.0,
          "text": "所以整个人站在阳光下"
        },
        {
          "start": 61.0,
          "end": 62.0,
          "text": "还挺有生命力的"
        },
        {
          "start": 62.0,
          "end": 64.0,
          "text": "简单热身一下就开大了"
        },
        {
          "start": 64.0,
          "end": 66.0,
          "text": "好久没摸球拍手都伸了"
        },
        {
          "start": 66.0,
          "end": 68.0,
          "text": "感觉打羽毛球对于我们这种"
        },
        {
          "start": 68.0,
          "end": 70.0,
          "text": "长期低头的上班族来说"
        },
        {
          "start": 70.0,
          "end": 71.0,
          "text": "还挺友好的"
        },
        {
          "start": 71.0,
          "end": 73.0,
          "text": "滚身的肌肉都参与其中"
        },
        {
          "start": 73.0,
          "end": 75.0,
          "text": "工作中的烦恼在近期的挥拍中"
        },
        {
          "start": 75.0,
          "end": 77.0,
          "text": "也能烟消云散"
        },
        {
          "start": 77.0,
          "end": 78.0,
          "text": "每次运动完之后"
        },
        {
          "start": 78.0,
          "end": 79.0,
          "text": "想试炼前的"
        },
        {
          "start": 79.0,
          "end": 80.0,
          "text": "但是又怕胖"
        },
        {
          "start": 80.0,
          "end": 81.0,
          "text": "我都会选择它来解差"
        },
        {
          "start": 81.0,
          "end": 83.0,
          "text": "这个是新出的韵尼口味"
        },
        {
          "start": 83.0,
          "end": 85.0,
          "text": "感觉有我的口红差不多大小"
        },
        {
          "start": 85.0,
          "end": 87.0,
          "text": "淡淡的紫色非常质疑"
        },
        {
          "start": 87.0,
          "end": 88.0,
          "text": "层层的拉花"
        },
        {
          "start": 88.0,
          "end": 90.0,
          "text": "就像小甜品一样很精美"
        },
        {
          "start": 92.73,
          "end": 94.73,
          "text": "芋泥脑袋肯定会很喜欢"
        },
        {
          "start": 94.73,
          "end": 96.73,
          "text": "它的口感就像吃芋泥血一样"
        },
        {
          "start": 96.73,
          "end": 97.73,
          "text": "缅密细腻"
        },
        {
          "start": 97.73,
          "end": 98.73,
          "text": "浓郁的奶香"
        },
        {
          "start": 98.73,
          "end": 99.73,
          "text": "带着芋泥的倾向"
        },
        {
          "start": 99.73,
          "end": 101.73,
          "text": "让人感觉幸福感爆棚"
        },
        {
          "start": 101.73,
          "end": 103.73,
          "text": "入口芋泥就化下来了"
        },
        {
          "start": 103.73,
          "end": 104.73,
          "text": "看看这个嘴馋的小差"
        },
        {
          "start": 104.73,
          "end": 105.73,
          "text": "又跑过来了"
        },
        {
          "start": 105.73,
          "end": 106.73,
          "text": "只能我独想了"
        },
        {
          "start": 106.73,
          "end": 107.73,
          "text": "口感很丰富"
        },
        {
          "start": 107.73,
          "end": 108.73,
          "text": "主要是这一小只"
        },
        {
          "start": 108.73,
          "end": 109.73,
          "text": "才六十一千卡"
        },
        {
          "start": 109.73,
          "end": 110.73,
          "text": "热量很低"
        },
        {
          "start": 110.73,
          "end": 111.73,
          "text": "吃起来轻负担"
        },
        {
          "start": 111.73,
          "end": 112.73,
          "text": "谁懂这一刻"
        },
        {
          "start": 112.73,
          "end": 113.73,
          "text": "摊在沙发上"
        },
        {
          "start": 113.73,
          "end": 114.73,
          "text": "露着小差还发着呆"
        },
        {
          "start": 114.73,
          "end": 115.73,
          "text": "又吃着美味的"
        },
        {
          "start": 115.73,
          "end": 116.73,
          "text": "芋泥冰淇淋"
        },
        {
          "start": 116.73,
          "end": 117.73,
          "text": "是何等的幸福"
        },
        {
          "start": 119.73,
          "end": 120.73,
          "text": "很简单"
        },
        {
          "start": 120.73,
          "end": 121.73,
          "text": "一个辣味的印面"
